{
  "name": "albionhelper",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller"
    ],
    "ignoredBuiltDependencies": []
  },
  "scripts": {
    "dev": "npm-run-all --parallel dev:electron dev:react",
    "dev:react": "vite",
    "dev:electron": "pnpm build:electron && cross-env NOVE_ENV=development electron .",
    "build:react": "tsc -b && vite build",
    "build:electron": "tsc --project src/electron/tsconfig.json",
    "lint": "eslint .",
    "preview": "vite preview",
    "dist:win": "pnpm build:electron && pnpm build:react && electron-builder --win --x64"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@tailwindcss/vite": "^4.1.17",
    "axios": "^1.13.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
